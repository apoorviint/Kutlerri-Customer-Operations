# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/customer_ops?schema=public"

# Session signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=""

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Internal company API
API_BASE_URL="https://api.internal.example.com"
API_TOKEN=""
# Header used to send API_TOKEN. "Authorization" sends "Bearer <token>"; anything else sends the raw token.
API_AUTH_HEADER="Authorization"

# Shared secret so a scheduler (cron, GitHub Actions) can call POST /api/sync
CRON_SECRET=""

# GitHub repo that admin uploads are committed to (token needs Contents: read & write)
GITHUB_TOKEN=""
GITHUB_OWNER="apoorviint"
GITHUB_REPO="Kutlerri-Customer-Operations"
GITHUB_BRANCH="main"
GITHUB_UPLOAD_DIR="uploads"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash") // empty for people who sign in with Google
  role         Role     @default(VIEWER)
  active       Boolean  @default(true) // an inactive user cannot sign in and is signed out within a minute
  createdAt    DateTime @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("users")
}

// ───────────────────────── reference data ─────────────────────────

enum ClientKind {
  CUSTOMER // shown in the dashboards
  INTERNAL // Kutlerri's own prospecting: stored, never shown
}

model Client {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  kind       ClientKind       @default(CUSTOMER)
  sortOrder  Int              @default(0) @map("sort_order")
  emailRules ApolloClientRule[]
  emails     Email[]
  assignments LineAssignment[]

  @@map("clients")
}

model Representative {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  internal Boolean @default(false) // Kutlerri's own caller: never shown in the dashboards
  agents   Agent[]
  assignments LineAssignment[]

  @@map("representatives")
}

// A real person on JustCall. Dashboards show the Representative; the agent is kept in the data.
model Agent {
  id               Int             @id @default(autoincrement())
  key              String          @unique // lower-cased, trimmed name (JustCall's casing is inconsistent)
  name             String
  representativeId Int?            @map("representative_id")
  representative   Representative? @relation(fields: [representativeId], references: [id])
  calls            Call[]

  @@map("agents")
}

// Which Apollo emails belong to which client. Precedence: mailbox, then sequence, then sender domain.
model ApolloClientRule {
  id       Int    @id @default(autoincrement())
  kind     String // 'domain' | 'mailbox' | 'sequence'
  value    String // lower-cased
  clientId Int    @map("client_id")
  client   Client @relation(fields: [clientId], references: [id])

  @@unique([kind, value])
  @@map("apollo_client_map")
}

// The call-logs API gives a bare date and time with no time zone, and not every agent's clock is the same.
// A rule says: "calls by this agent (and/or on this line) from this local date on were logged in this zone".
model CallTimezoneRule {
  id        Int       @id @default(autoincrement())
  agentKey  String?   @map("agent_key")
  lineNo10  String?   @map("line_no10")
  zone      String // IANA name, or a fixed offset such as 'UTC-3'
  validFrom DateTime  @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  note      String?

  @@map("call_timezone_rules")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// ───────────────────────── who dialed for whom ─────────────────────────

// One uploaded file (or import) of the phone-number sheet. Kept so it can be rolled back.
model AssignmentUpload {
  id           Int       @id @default(autoincrement())
  source       String // upload | reference-import | override
  fileName     String?   @map("file_name")
  fileHash     String?   @map("file_hash")
  fileKey      String?   @map("file_key") // where the original file is kept (private storage)
  uploadedBy   String?   @map("uploaded_by")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  status       String    @default("committed") // committed | rolled_back
  rolledBackAt DateTime? @map("rolled_back_at")
  rolledBackBy String?   @map("rolled_back_by")
  summary      Json?
  assignments  LineAssignment[]

  @@map("assignment_uploads")
}

// "This phone line belonged to this Representative and client from this date to that date."
// Weekly rows cover Monday to Sunday, monthly rows a whole month, daily rows one day.
// Several rows can cover the same date; the most specific (shortest) period wins.
model LineAssignment {
  id                   Int              @id @default(autoincrement())
  phoneNo10            String           @map("phone_no10")
  representativeId     Int              @map("representative_id")
  representative       Representative   @relation(fields: [representativeId], references: [id])
  clientId             Int              @map("client_id")
  client               Client           @relation(fields: [clientId], references: [id])
  validFrom            DateTime         @map("valid_from") @db.Date
  validTo              DateTime?        @map("valid_to") @db.Date // empty = open-ended
  granularity          String // daily | weekly | monthly | custom | override
  priority             Int              @default(1) // 1 = from an uploaded sheet, 0 = a standing fallback (override)
  uploadId             Int              @map("upload_id")
  upload               AssignmentUpload @relation(fields: [uploadId], references: [id])
  supersededByUploadId Int?             @map("superseded_by_upload_id") // a later upload replaced this period
  note                 String?

  @@index([phoneNo10, validFrom])
  @@index([uploadId])
  @@map("line_assignments")
}

// ───────────────────────── ingested data ─────────────────────────

// JustCall calls, from the call-logs API (/v1/calls)
model Call {
  id               String   @id // provider id
  contactNo10      String?  @map("contact_no10")
  justcallNo10     String?  @map("justcall_no10")
  lineName         String?  @map("line_name")
  agentId          Int?     @map("agent_id")
  agent            Agent?   @relation(fields: [agentId], references: [id])
  recordingUrl     String?  @map("recording_url")
  durationSec      Int      @default(0) @map("duration_sec")
  // exactly as the provider sent them
  localDate        DateTime @map("local_date") @db.Date
  localTime        String   @map("local_time")
  // what we worked out from them
  tzUsed           String   @map("tz_used")
  occurredAt       DateTime @map("occurred_at") // UTC instant
  shiftDate        DateTime @map("shift_date") @db.Date // 5 PM IST to 5 PM IST
  dispositionRaw   String?  @map("disposition_raw")
  dispositionKey   String?  @map("disposition_key") // null = no disposition (counted as No Answer later)
  providerSyncedAt DateTime? @map("provider_synced_at")
  ingestedAt       DateTime @default(now()) @map("ingested_at")
  updatedAt        DateTime @default(now()) @map("updated_at")
  raw              Json
  attribution      CallAttribution?

  @@index([shiftDate])
  @@index([occurredAt])
  @@index([agentId])
  @@index([justcallNo10])
  @@map("calls")
}

// Apollo emails, from the call-logs API (/v1/emails)
model Email {
  id             String    @id // apollo_message_id
  mailbox        String? // sender address, lower-cased
  senderDomain   String?   @map("sender_domain")
  clientId       Int?      @map("client_id") // null = not mapped to a client yet
  client         Client?   @relation(fields: [clientId], references: [id])
  sequence       String?
  sequenceId     String?   @map("sequence_id")
  step           Int?
  template       String?
  toEmail        String?   @map("to_email")
  toName         String?   @map("to_name")
  toCompany      String?   @map("to_company")
  subject        String?
  sentAt         DateTime? @map("sent_at") // UTC
  sentDatePacific DateTime? @map("sent_date_pacific") @db.Date // the date filter uses Apollo's Pacific date
  scheduledAt    DateTime? @map("scheduled_at")
  sent           Boolean   @default(false)
  bounced        Boolean   @default(false)
  opened         Boolean   @default(false)
  clicked        Boolean   @default(false)
  unsubscribed   Boolean   @default(false)
  replied        Boolean   @default(false)
  contactStage   String?   @map("contact_stage")
  bodyHtml       String?   @map("body_html") // not provided by the call-logs API yet
  replyText      String?   @map("reply_text")
  providerSyncedAt DateTime? @map("provider_synced_at")
  ingestedAt     DateTime  @default(now()) @map("ingested_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")
  raw            Json

  @@index([sentDatePacific])
  @@index([clientId, sentDatePacific])
  @@index([senderDomain])
  @@map("emails")
}

// One row per ingestion run. Re-running a job for a date range is always safe.
model SyncRun {
  id          String    @id @default(cuid())
  source      String // 'calls' | 'emails' | 'recompute-call-times'
  kind        String // 'incremental' | 'backfill' | 'range'
  windowFrom  DateTime? @map("window_from") @db.Date
  windowTo    DateTime? @map("window_to") @db.Date
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  status      String    @default("running") // running | ok | warning | failed
  fetched     Int       @default(0)
  inserted    Int       @default(0)
  updated     Int       @default(0)
  unchanged   Int       @default(0)
  skipped     Int       @default(0)
  error       String?
  details     Json?
  triggeredBy String    @default("schedule") @map("triggered_by")

  @@index([source, startedAt])
  @@map("sync_runs")
}

// Stops two copies of the same job running at once (the 15-minute timer and a manual run, say).
model JobLock {
  name     String   @id
  lockedAt DateTime @map("locked_at")
  lockedBy String   @map("locked_by")

  @@map("job_locks")
}

// Which Representative and client each call belongs to. Always recomputable from calls + assignments.
model CallAttribution {
  callId           String   @id @map("call_id")
  call             Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  status           String // CLIENT | INTERNAL | UNASSIGNED | CONFLICT
  clientId         Int?     @map("client_id")
  representativeId Int?     @map("representative_id")
  assignmentId     Int?     @map("assignment_id")
  reason           String // sheet | fallback | shared-line-by-agent | no-assignment | ambiguous
  computedAt       DateTime @default(now()) @map("computed_at")

  @@index([status])
  @@index([clientId, representativeId])
  @@map("call_attribution")
}

// Daily counts for calls that belong to a client (the three dashboards read from here, not from raw calls).
model DailyRollup {
  id               Int      @id @default(autoincrement())
  shiftDate        DateTime @map("shift_date") @db.Date
  clientId         Int      @map("client_id")
  representativeId Int      @map("representative_id")
  agentId          Int?     @map("agent_id")
  lineNo10         String?  @map("line_no10")
  calls            Int
  meaningful       Int // a connect longer than 90 seconds
  mqlOver90        Int      @map("mql_over_90")
  dMql             Int      @map("d_mql")
  dInterested      Int      @map("d_interested")
  dCallback        Int      @map("d_callback")
  dNotInterested   Int      @map("d_not_interested")
  dWrongNumber     Int      @map("d_wrong_number")
  dMqlFu           Int      @map("d_mql_fu")
  dDnc             Int      @map("d_dnc")
  dNoAnswer        Int      @map("d_no_answer")
  dBadNumber       Int      @map("d_bad_number")
  dVoicemail       Int      @map("d_voicemail")
  dMeeting         Int      @map("d_meeting")
  dBlank           Int      @map("d_blank") // no disposition (counted as No Answer by the dashboards)
  dOther           Int      @map("d_other") // a disposition text we do not recognise

  @@index([shiftDate])
  @@index([clientId, shiftDate])
  @@index([representativeId, shiftDate])
  @@map("daily_rollups")
}

// ───────────────────────── revenue and prospect matching ─────────────────────────

// One order from the billing sheet. Revenue is the invoice Total, counted by order date.
// (Phase 4 adds the upload; until then the reference import fills this.)
model BillingOrder {
  id               Int            @id @default(autoincrement())
  invoiceNo        String         @unique @map("invoice_no")
  clientId         Int            @map("client_id")
  representativeId Int            @map("representative_id")
  createdDate      DateTime?      @map("created_date") @db.Date
  orderDate        DateTime       @map("order_date") @db.Date
  account          String?
  subtotal         Decimal?       @db.Decimal(12, 2)
  tax              Decimal?       @db.Decimal(12, 2)
  tip              Decimal?       @db.Decimal(12, 2)
  fee              Decimal?       @db.Decimal(12, 2)
  discount         Decimal?       @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  uploadId         Int?           @map("upload_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([orderDate])
  @@index([clientId, orderDate])
  @@index([representativeId, orderDate])
  @@map("billing_orders")
}

// Who a prospect's phone number belongs to, within one client's databases:
// one person, or several people sharing the number. No row means "not in your databases".
// (Phase 4 builds this from the uploaded databases; until then the reference import fills it.)
model PhoneMatch {
  clientId   Int      @map("client_id")
  phoneNo10  String   @map("phone_no10")
  kind       String // 'one' | 'multiple'
  name       String?
  company    String?
  title      String?
  candidates String? // for 'multiple': "Name (Title), Name (Title), +N more"
  source     String   @default("reference-import")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@id([clientId, phoneNo10])
  @@map("phone_matches")
}

// ───────────── admin console (Phase 4) ─────────────

// Every upload and every setting change: who, what, when.
model AuditLog {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  actor   String
  action  String // e.g. "assignments.upload", "settings.update"
  target  String?
  details Json?

  @@index([at])
  @@map("audit_log")
}

// One uploaded prospect database file for one client.
model ProspectBatch {
  id             Int       @id @default(autoincrement())
  clientId       Int       @map("client_id")
  fileName       String    @map("file_name")
  fileHash       String?   @map("file_hash")
  fileKey        String?   @map("file_key") // where the original file is kept (private storage)
  uploadedBy     String?   @map("uploaded_by")
  uploadedAt     DateTime  @default(now()) @map("uploaded_at")
  finishedAt     DateTime? @map("finished_at")
  status         String    @default("processing") // processing | committed | failed | rolled_back
  replace        Boolean   @default(false)
  supersededById Int?      @map("superseded_by_id") // set when a later "replace" upload took this client's place
  rowsRead       Int       @default(0) @map("rows_read")
  phonesIndexed  Int       @default(0) @map("phones_indexed")
  newlyMatched   Int       @default(0) @map("newly_matched")
  progress       Json? // { sheet, rows } while running
  sheets         Json? // per sheet: name, rows, detected columns
  error          String?

  @@index([clientId])
  @@map("prospect_batches")
}

// One row per (person, phone number) read from a database. The match table is built from these.
model ProspectPhone {
  id        BigInt  @id @default(autoincrement())
  batchId   Int     @map("batch_id")
  clientId  Int     @map("client_id")
  phoneNo10 String  @map("phone_no10")
  name      String?
  title     String?
  company   String?

  @@index([clientId, phoneNo10])
  @@index([batchId])
  @@map("prospect_phones")
}

model BillingUpload {
  id           Int       @id @default(autoincrement())
  fileName     String?   @map("file_name")
  fileHash     String?   @map("file_hash")
  fileKey      String?   @map("file_key")
  uploadedBy   String?   @map("uploaded_by")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  status       String    @default("committed") // committed | rolled_back
  rolledBackAt DateTime? @map("rolled_back_at")
  rolledBackBy String?   @map("rolled_back_by")
  summary      Json?

  @@map("billing_uploads")
}

// What an order looked like before an upload touched it (null = the upload created it), so an upload can be rolled back.
model BillingChange {
  id        Int     @id @default(autoincrement())
  uploadId  Int     @map("upload_id")
  invoiceNo String  @map("invoice_no")
  before    Json?

  @@index([uploadId])
  @@map("billing_changes")
}

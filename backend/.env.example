PORT=4000

# PostgreSQL. The database should be UTF-8 (names in the data are not all plain English).
# All times are stored in UTC explicitly, so the server's own time zone does not matter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/customer_ops?schema=public"

# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# First admin account, created by `npm run db:seed` (email and password login until Google sign-in arrives in Phase 5)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Where calls and emails come from (currently open; set a token only if it gets protected)
CALL_LOGS_API_URL="https://call-logs-api-1010076791650.us-central1.run.app"
CALL_LOGS_API_TOKEN=""

# Lets Cloud Scheduler call POST /api/jobs/<name>/run?wait=1 with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# true = run the 15 and 30 minute timers inside this process (local development).
# In production leave it off and let Cloud Scheduler call the job endpoints.
ENABLE_SCHEDULER=false

# Only needed if a browser calls the backend directly instead of through the frontend proxy
CORS_ORIGIN=""

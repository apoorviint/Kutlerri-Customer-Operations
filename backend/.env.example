PORT=4000

# PostgreSQL (calls and emails synced from the call-logs API, plus users)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/customer_ops?schema=public"

# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Upstream call-logs API (currently public; set a token only if it gets protected)
CALL_LOGS_API_URL="https://call-logs-api-1010076791650.us-central1.run.app"
CALL_LOGS_API_TOKEN=""

# Lets a scheduler call POST /api/sync?wait=1 with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# Admin uploads are committed to this repo/branch; pushing triggers your host to rebuild.
# FINE-GRAINED token, only this repository, Repository permissions: Contents = Read and write.
GITHUB_TOKEN=""
GITHUB_OWNER="apoorviint"
GITHUB_REPO="Kutlerri-Customer-Operations"
GITHUB_BRANCH="main"
# Folder in the repo the backend reads spreadsheets from (must match DATA_DIR once deployed)
GITHUB_UPLOAD_DIR="backend/data"
DATA_DIR="data"

# Only needed if a browser calls the backend directly instead of through the frontend proxy
CORS_ORIGIN=""

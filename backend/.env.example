PORT=4000
# true on the server. Turns on secure cookies, HSTS and request logging as JSON.
NODE_ENV=development

# PostgreSQL (Neon, Cloud SQL, …). The database should be UTF-8.
# All times are stored in UTC explicitly, so the server's own time zone does not matter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/customer_ops?schema=public"

# Signs the login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── Sign-in ──
# The website's public address. Google sends people back to ${PUBLIC_URL}/api/auth/google/callback
PUBLIC_URL="http://localhost:3000"
# Google sign-in (OAuth client of type "Web application"; see docs/DEPLOY.md). Leave empty in development.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only accounts on this domain may sign in, e.g. company.com
ALLOWED_EMAIL_DOMAIN=""
# Comma-separated. These people become administrators when they first sign in; everyone else is a viewer.
ADMIN_EMAILS=""
# Email + password form. Default: on in development, off in production once Google is set up. Force with true/false.
ALLOW_PASSWORD_LOGIN=""
# First admin for local development, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ── Data ──
# Where calls and emails come from (currently open; set a token only if it gets protected)
CALL_LOGS_API_URL="https://call-logs-api-1010076791650.us-central1.run.app"
CALL_LOGS_API_TOKEN=""

# Lets Cloud Scheduler call POST /api/jobs/<name>/run?wait=1 with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""
# true = run the 15 and 30 minute timers inside this process (local development only)
ENABLE_SCHEDULER=false

# Where uploaded files are kept. Private: never served. On Cloud Run mount a storage bucket here.
UPLOAD_DIR="./data/uploads"

# Only needed if a browser calls the backend directly instead of through the frontend proxy
CORS_ORIGIN=""

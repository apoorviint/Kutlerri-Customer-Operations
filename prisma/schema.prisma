generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
}

// Calls and mails are fetched from the internal API. `payload` keeps the raw JSON so the
// mapping in src/lib/api-client.ts can change without losing data.
model Call {
  id          String    @id @default(cuid())
  externalId  String    @unique
  direction   String?   // inbound | outbound
  agent       String?
  customer    String?
  status      String?
  durationSec Int?
  startedAt   DateTime?
  payload     Json
  syncedAt    DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}

model Mail {
  id         String    @id @default(cuid())
  externalId String    @unique
  subject    String?
  fromAddr   String?
  toAddr     String?
  status     String?
  sentAt     DateTime?
  payload    Json
  syncedAt   DateTime  @default(now())

  @@index([sentAt])
  @@index([status])
}

model SyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  calls      Int       @default(0)
  mails      Int       @default(0)
  error      String?
}

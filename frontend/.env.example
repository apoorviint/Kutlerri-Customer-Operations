# Where the backend runs: the customer_call_logs_dashboard API (FastAPI, `call-email-api`, port 8080).
# The frontend proxies /api/* to it, so the browser only ever talks to the frontend.
BACKEND_URL="http://localhost:8080"

# Saved uploads (who-dialed-for-whom, billing, prospect databases) are committed to GitHub by the website's
# server, under uploads/ on this branch. A fine-grained token with "Contents: Read and write" on that one
# repository. It is used on the server only and never reaches the browser.
GITHUB_TOKEN=""
GITHUB_UPLOADS_REPO="apoorviint/Kutlerri-Customer-Operations"
GITHUB_UPLOADS_BRANCH="main"
GITHUB_UPLOADS_PATH="uploads"
